# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Web server
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# SQLite database file
DB_FILE=rollingdie.db

# Discord bot (Discord Developer Portal)
# Token: Bot tab > Reset Token
# Client ID: General Information > Application ID
# Guild ID: the first number after /channels/ in your server URL
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
